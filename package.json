{
  "name": "wheel-duel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --port 5173 --strictPort",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "dev:wide": "VITE_VARIANT=wide vite --port 5174 --strictPort"
  },
  "dependencies": {
    "three": "^0.170.0",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
