{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wheel-duel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby", "Board"] }],
  // The game is served on this subdomain. Cloudflare creates the DNS record on deploy.
  "routes": [{ "pattern": "duel.kaancavdar.com", "custom_domain": true }],
  "workers_dev": true,
  // .dev.vars overrides these locally.
  "vars": { "TICKET_BITS": "14", "ALLOWED_ORIGINS": "https://duel.kaancavdar.com" },
  "observability": { "enabled": true }
}
