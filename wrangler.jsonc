{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamstride",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby", "Board"] }],
  // The project is closed: hamstride.xyz is no longer attached to the worker. To serve it again, add
  // { "pattern": "hamstride.xyz", "custom_domain": true } (and www.hamstride.xyz) under "routes" and deploy.
  // No workers.dev copy either, so the worker is not reachable from the internet.
  "workers_dev": false,
  // Local dev: keep requests on localhost instead of rewriting them to the production subdomain.
  "dev": { "host": "localhost:5173" },
  // .dev.vars overrides these locally. Secrets (TICKET_SECRET, REFEREE_KEY) are set with
  // `wrangler secret put`, never here. The escrow address is public.
  "vars": {
    "TICKET_BITS": "14",
    "ALLOWED_ORIGINS": "https://hamstride.xyz,https://www.hamstride.xyz",
    "ESCROW_ADDRESS": "0x6a9E96118935ECdc30c790562CDF4b7288Bf708a"
  },
  "observability": { "enabled": true }
}
